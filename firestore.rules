rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public storefront can read active product listings.
    // Only trusted/admin-authenticated users should be allowed to write products.
    match /products/{productId} {
      allow read: if resource.data.active == true;
      allow write: if false; // Admin Panel will add authenticated owner permissions later.
    }

    // Customer checkout can create orders. Customers cannot read or edit orders.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'customer', 'items', 'total', 'status', 'createdAt', 'source'
        ]) &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'website' &&
        request.resource.data.customer is map &&
        request.resource.data.customer.keys().hasOnly(['name','phone','address','note']) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.name.size() <= 80 &&
        request.resource.data.customer.phone is string &&
        request.resource.data.customer.phone.size() >= 7 &&
        request.resource.data.customer.phone.size() <= 20 &&
        request.resource.data.customer.address is string &&
        request.resource.data.customer.address.size() > 0 &&
        request.resource.data.customer.address.size() <= 500 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 30 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.createdAt is string;
      allow read, update, delete: if false;
    }
  }
}
